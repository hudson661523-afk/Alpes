# Server-side mail configuration example — COPY ONLY, NO REAL SECRETS.
# Hostinger shared hosting normally uses the protected PHP file described in
# docs/email-setup.md instead of a .env file.

ALPES_SMTP_HOST=smtp.gmail.com
ALPES_SMTP_PORT=587
ALPES_SMTP_ENCRYPTION=starttls
ALPES_SMTP_USERNAME=alpestransport@gmail.com
ALPES_SMTP_PASSWORD=REPLACE_WITH_GMAIL_APP_PASSWORD

ALPES_FROM_EMAIL=alpestransport@gmail.com
ALPES_BOOKING_TO=alpestransport@gmail.com

# Optional: absolute path to a protected PHP config file outside public_html.
# ALPES_MAIL_CONFIG=/home/USERNAME/alpes-transport-private/mail.php
